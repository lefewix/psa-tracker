[Unit]
Description=Hourly PSA scan (cookie reuse; full browser login at PSA_LOGIN_HOURS)

[Timer]
# run_scan.sh reuses the stored cookie most hours and only does the real
# browser login at 1am/1pm (PSA_LOGIN_HOURS) or when the cookie dies.
OnCalendar=*-*-* *:00:00
Persistent=true

[Install]
WantedBy=timers.target
