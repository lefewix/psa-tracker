[Unit]
Description=PSA scan on a random 9-22 min interval (cookie reuse; browser login at PSA_LOGIN_HOURS)

[Timer]
# No fixed grid: each run starts 9 to 22 min after the previous one finished
# (OnUnitInactiveSec + a fresh RandomizedDelaySec draw every firing), so the
# pattern never looks like a bot on a clock. run_scan.sh reuses the stored
# cookie; the real browser login still only runs once per PSA_LOGIN_HOURS hour
# or when the cookie dies.
OnBootSec=2min
OnUnitInactiveSec=9min
RandomizedDelaySec=13min
FixedRandomDelay=false

[Install]
WantedBy=timers.target
