[Unit]
Description=PSA cookie refresh + submission scan (all accounts)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/psa-tracker/run_scan.sh
# run_scan.sh caps each account at ~29 min (login 600s, or 900s while otp.armed,
# + scan 420s + values 420s). Cover the whole fleet so systemd never SIGTERMs the
# group mid account and leaves otp.armed behind: 4 accounts x that ceiling.
TimeoutStartSec=7200
