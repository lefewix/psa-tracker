# /etc/psa-tracker.env - global config (chmod 600). Per-account secrets live in
# /opt/psa-tracker/accounts/<id>/account.env (created by add_account.sh).
PSA_SECRET='CHANGE_ME_openssl_rand_hex_32'
PSA_BIND=0.0.0.0
PSA_PORT=8080
SITE_TITLE='Submissions'
SITE_TAGLINE='PSA GRADING TRACKER'
# Set 0 only if you serve plain HTTP with no TLS reverse proxy:
PSA_COOKIE_SECURE=1
# Store branding: primary accent + ambient secondary (any hex; all other
# shades derive automatically). Defaults are the violet theme:
PSA_ACCENT=#8b5cf6
PSA_ACCENT_2=#6366f1
# Timezone timestamps are displayed in (any IANA name):
PSA_DISPLAY_TZ=America/Toronto
# Scraper region (US accounts: en-US / US):
PSA_LOCALE=en-CA
PSA_LOCATION=CA
# Optional Discord webhook for status-change notifications:
DISCORD_WEBHOOK=
