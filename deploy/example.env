# /etc/psa-tracker.env - the one config list (chmod 600). Every environment key
# the code reads is here. Commented-out keys show the built-in default; set one
# only to change it. Per-account keys live in accounts/<id>/account.env and are
# listed at the bottom.

# --- Web server (app.py) ---
PSA_SECRET='CHANGE_ME_openssl_rand_hex_32'   # required: session-cookie signing key
PSA_BIND=0.0.0.0
PSA_PORT=8080
#COOKIE_DAYS=30                              # session cookie lifetime
# Set 0 only if you serve plain HTTP with no TLS reverse proxy:
PSA_COOKIE_SECURE=1
#PSA_ACCOUNTS_DIR=/opt/psa-tracker/accounts  # one directory per tracked PSA account
#PSA_GLOBAL_ENV=/etc/psa-tracker.env         # this file; /settings writes back to it
#PSA_IMG_CACHE=/opt/psa-tracker/imgcache     # proxied PSA card images (shared)

# --- Settings panel (app.py) ---
# sha256 hex of a settings password. Unset means /settings is disabled:
#PSA_SETTINGS_PW_HASH=
#PSA_SETTINGS_MINUTES=60                     # how long a settings session lasts
# 0 on personal instances where password holders are friends, not admins: hides
# the gear and makes /settings always ask for the settings password:
#PSA_SETTINGS_GEAR=1

# --- Branding (app.py) ---
SITE_TITLE='Submissions'
SITE_TAGLINE='PSA grading tracker'
# Store branding: primary accent + ambient secondary (any hex; all other
# shades derive automatically):
PSA_ACCENT=#3a6fd8
PSA_ACCENT_2=#5b8def
# 'light' (default) for the white store-front theme, 'dark' for the dark one:
PSA_THEME=light
# Optional store logo shown above the site title (svg/png/jpg). Drop the file
# at this path (default /opt/psa-tracker/logo.svg) and it appears automatically:
#PSA_LOGO=/opt/psa-tracker/logo.png
# Set 1 if the logo is dark-on-light (or has a baked-in white box): dark mode
# then renders it on a white rounded chip so it stays legible:
#PSA_LOGO_CHIP=1
# Or, for transparent dark-on-light marks whose shapes read well alone:
# render as a white monochrome silhouette in dark mode instead of a chip:
#PSA_LOGO_DARK=silhouette
# Optional PNG icons for Safari and iOS, which ignore the built-in SVG favicon:
#PSA_FAVICON=/opt/psa-tracker/favicon.png
#PSA_TOUCH_ICON=/opt/psa-tracker/apple-touch-icon.png
# Timezone timestamps are displayed in (any IANA name):
PSA_DISPLAY_TZ=America/Toronto
# Shared key for the read-only /hub/summary JSON feed. Unset means 404:
#PSA_HUB_KEY=

# --- Scanner (run_scan.sh, psa_watch.py, psa_login.py) ---
# Scraper region (US accounts: en-US / US):
PSA_LOCALE=en-CA
PSA_LOCATION=CA
#PSA_ORDERS_URL=                             # override the orders API URL (debugging only)
#PSA_SPEC_DEPT_ID=10                         # spec-image department; 10 = TCG/trading cards
#POLL_INTERVAL=21600                         # psa_watch.py loop mode only, ignored with --once
#PSA_LOGIN_HOURS='01 13'                     # hours the full browser login runs
#PSA_TZ=America/Toronto                      # timezone those hours are read in
#PSA_ALERT_AFTER=2                           # consecutive scan failures before an alert (repeats every 12 runs)
# Optional Discord webhook for status-change notifications:
DISCORD_WEBHOOK=

# --- Card values (psa_values.py) ---
# 1 runs psa_values.py on login-hour scans (PSA cert-page estimate + comp sales,
# converted with a fresh USDCAD rate) and shows the values on the site.
PSA_VALUES=0
# Cert pages per values run, and how old a value may get before a refetch:
#PSA_VALUES_BATCH=40
#PSA_VALUES_MAX_AGE=14

# --- Per-account: accounts/<id>/account.env, written by add_account.sh ---
# LABEL             display name on that account's pages
# SITE_PASSWORD     the password that logs friends into this account (unique per account)
# PSA_LOGIN_EMAIL   PSA sign-in email
# PSA_LOGIN_PW      PSA sign-in password
# PSA_COOKIE        current PSA session cookie; psa_login.py rewrites it
# PSA_PRICES        optional fee table, "regular:109,max:89.99,bulk:34.99,value:45.99"
# DISCORD_WEBHOOK   optional per-account override of the global webhook
# run_scan.sh exports PSA_ACCT_ID, PSA_DB, PSA_OWN_DB and PSA_ENV_FILE for each
# account as it runs; you never set those by hand.
